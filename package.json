{
	"name": "tally",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @tally/backend start:dev\" \"pnpm --filter @tally/backend start:worker:dev\" \"pnpm --filter @tally/frontend dev\"",
		"dev:db": "docker compose up -d db",
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"test:integration": "pnpm --filter @tally/backend test:integration",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"migrate": "pnpm --filter @tally/backend migration:run"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"concurrently": "^9.1.2"
	}
}
